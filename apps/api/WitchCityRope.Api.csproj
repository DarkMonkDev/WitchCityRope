<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>51c30e23-eda7-47d3-b7ba-81004187bc0d</UserSecretsId>
  </PropertyGroup>

  <!-- Exclude archived files from compilation -->
  <ItemGroup>
    <Compile Remove="_archive/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.S3" />
    <PackageReference Include="Hangfire.AspNetCore" />
    <PackageReference Include="Hangfire.PostgreSql" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="PayPalCheckoutSdk" />
    <PackageReference Include="PayPalHttp" />
    <PackageReference Include="SendGrid" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" />
    <PackageReference Include="AspNetCore.HealthChecks.NpgSql" />

    <!-- CRC32 for PayPal webhook signature verification -->
    <PackageReference Include="Crc32.NET" />

    <!-- Authentication packages -->
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" />
    <PackageReference Include="BCrypt.Net-Next" />

    <!-- Validation packages -->
    <PackageReference Include="FluentValidation.AspNetCore" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />

    <!-- Content sanitization -->
    <PackageReference Include="HtmlSanitizer" />

    <!-- OpenAPI generation and export -->
    <PackageReference Include="NSwag.AspNetCore" />
  </ItemGroup>

  <!-- Post-build: Export OpenAPI specification -->
  <Target Name="ExportOpenAPI" AfterTargets="Build">
    <Exec Command="bash Scripts/post-build-export-openapi.sh" Condition="Exists('Scripts/post-build-export-openapi.sh')" ContinueOnError="true" />
  </Target>

</Project>
