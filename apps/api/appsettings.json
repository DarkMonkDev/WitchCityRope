{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Error",
        "Hangfire": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}{NewLine}  {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": ["FromLogContext", "WithMachineName", "WithEnvironmentName", "WithThreadId"],
    "Properties": {
      "Application": "WitchCityRope.Api"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5433;Database=witchcityrope;Username=witchcityrope;Password=witchcityrope"
  },
  "PayPal": {
    "ClientId": "",
    "Secret": "",
    "Mode": "sandbox",
    "WebhookId": "",
    "ReturnUrl": "https://witchcityrope.com/payment/success",
    "CancelUrl": "https://witchcityrope.com/payment/cancel"
  },
  "CreditCardProcessor": {
    "ActiveProcessor": "AuthorizeNet",
    "AuthorizeNet": {
      "ApiLoginId": "",
      "TransactionKey": "",
      "ClientKey": "",
      "TestMode": true
    }
  },
  "Vetting": {
    "EstimatedReviewDays": 14,
    "EmailEnabled": true,
    "SendGridApiKey": "",
    "SendGridSandboxMode": false,
    "FromEmail": "info@witchcityrope.com",
    "FromName": "WitchCityRope"
  },
  "BackupConfiguration": {
    "Database": {
      "Host": "localhost",
      "Port": 5434,
      "DatabaseName": "witchcityrope_dev",
      "SchemaName": "public",
      "Username": "witchcity_user",
      "Password": ""
    },
    "Spaces": {
      "Endpoint": "https://nyc3.digitaloceanspaces.com",
      "BucketName": "witchcityrope",
      "AccessKey": "",
      "SecretKey": "",
      "FolderPrefix": "backups"
    },
    "BackupOptions": {
      "TempDirectory": "/tmp",
      "TimeoutSeconds": 300
    }
  }
}
