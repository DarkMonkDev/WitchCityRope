      SELECT e0."Id", e0."CancellationCloseHours", e0."CancellationOpenHours", e0."Capacity", e0."CreatedAt", e0."Description", e0."EndDate", e0."EventType", e0."IsPublished", e0."Policies", e0."RegistrationCloseHours", e0."RegistrationOpenHours", e0."ShortDescription", e0."StartDate", e0."Title", e0."UpdatedAt", e0."VenueId", e0."VolunteerCancellationCloseHours", e0."VolunteerRegistrationCloseHours", t."Id", t."Available", t."CreatedAt", t."DefaultPrice", t."Description", t."EventId", t."MaxPrice", t."MinPrice", t."Name", t."Price", t."PricingType", t."SessionId", t."UpdatedAt"
      FROM (
          SELECT e."Id", e."CancellationCloseHours", e."CancellationOpenHours", e."Capacity", e."CreatedAt", e."Description", e."EndDate", e."EventType", e."IsPublished", e."Policies", e."RegistrationCloseHours", e."RegistrationOpenHours", e."ShortDescription", e."StartDate", e."Title", e."UpdatedAt", e."VenueId", e."VolunteerCancellationCloseHours", e."VolunteerRegistrationCloseHours"
          FROM public."Events" AS e
          WHERE e."Id" = @__eventId_0
          LIMIT 1
      ) AS e0
      LEFT JOIN public."TicketTypes" AS t ON e0."Id" = t."EventId"
      ORDER BY e0."Id"
