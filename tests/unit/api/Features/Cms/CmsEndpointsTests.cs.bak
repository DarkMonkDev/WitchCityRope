    /// <summary>
    /// Test: UpdatePage sanitizes content and removes XSS
    /// </summary>
    [Fact]
    public async Task UpdatePage_SanitizesContentAndRemovesXss()
    {
        // Arrange
        var page = new ContentPage
        {
            Slug = "test-page",
            Title = "Test",
            Content = "<p>Original</p>",
            IsPublished = true,
            CreatedAt = DateTime.UtcNow,
            UpdatedAt = DateTime.UtcNow,
            CreatedBy = _testAdmin.Id,
            LastModifiedBy = _testAdmin.Id,
            LastModifiedByUser = _testAdmin
        };
        _dbContext.ContentPages.Add(page);
        await _dbContext.SaveChangesAsync();

        var maliciousContent = "<p>Safe content</p><script>alert('xss')</script>";
        var request = new UpdateContentPageRequest
        {
            Title = "Updated",
            Content = maliciousContent
        };

        var cleanContent = "<p>Safe content</p>";
        _mockSanitizer.Sanitize(maliciousContent).Returns(cleanContent);

        var user = CreateClaimsPrincipal(_testAdmin.Id);

        // Act
        var result = await WitchCityRope.Api.Features.Cms.CmsEndpoints.UpdatePage(
            page.Id,
            request,
            user,
            _dbContext,
            _mockSanitizer,
            _mockLogger,
            CancellationToken.None
        );

        // Assert
        _mockSanitizer.Received(1).Sanitize(maliciousContent);

        var okResult = result as Microsoft.AspNetCore.Http.HttpResults.Ok<ContentPageDto>;
        okResult!.Value!.Content.Should().Be(cleanContent);
        okResult.Value.Content.Should().NotContain("<script>");
    }

