    /// <summary>
    /// Test: UpdatePage with empty content after sanitization returns 400 BadRequest
    /// </summary>
    [Fact]
    public async Task UpdatePage_WithEmptyContentAfterSanitization_Returns400BadRequest()
    {
        // Arrange
        var page = new ContentPage
        {
            Slug = "test-page",
            Title = "Test",
            Content = "<p>Test</p>",
            IsPublished = true,
