    #region GetAllPages Tests

    /// <summary>
    /// Test: GetAllPages returns all pages with summaries in 200 OK response
    /// </summary>
    [Fact]
    public async Task GetAllPages_ReturnsAllPagesWithSummaries()
    {
        // Arrange
        var page1 = new ContentPage
        {
            Slug = "about",
            Title = "About Us",
            Content = "<p>About content</p>",
            IsPublished = true,
            CreatedAt = DateTime.UtcNow.AddDays(-10),
            UpdatedAt = DateTime.UtcNow.AddDays(-5),
            CreatedBy = _testAdmin.Id,
            LastModifiedBy = _testAdmin.Id,
            LastModifiedByUser = _testAdmin
        };

        var page2 = new ContentPage
        {
            Slug = "contact",
            Title = "Contact Us",
            Content = "<p>Contact content</p>",
            IsPublished = true,
            CreatedAt = DateTime.UtcNow.AddDays(-8),
            UpdatedAt = DateTime.UtcNow.AddDays(-2),
            CreatedBy = _testAdmin.Id,
            LastModifiedBy = _testAdmin.Id,
            LastModifiedByUser = _testAdmin
        };

        _dbContext.ContentPages.AddRange(page1, page2);
        await _dbContext.SaveChangesAsync();

        // Add some revisions
        var revision1 = new ContentRevision
        {
            ContentPageId = page1.Id,
            Title = "Old About",
            Content = "<p>Old</p>",
            CreatedAt = DateTime.UtcNow.AddDays(-5),
            CreatedBy = _testAdmin.Id
        };
        _dbContext.ContentRevisions.Add(revision1);
        await _dbContext.SaveChangesAsync();

        // Act
        var result = await WitchCityRope.Api.Features.Cms.CmsEndpoints.GetAllPages(
            _dbContext,
            CancellationToken.None
        );

        // Assert
        result.Should().BeOfType<Microsoft.AspNetCore.Http.HttpResults.Ok<List<CmsPageSummaryDto>>>();
        var okResult = result as Microsoft.AspNetCore.Http.HttpResults.Ok<List<CmsPageSummaryDto>>;
        okResult!.Value.Should().NotBeNull();
        okResult.Value!.Should().HaveCount(2);

        // Verify page1 has 1 revision
        var page1Summary = okResult.Value.First(p => p.Slug == "about");
        page1Summary.RevisionCount.Should().Be(1);
        page1Summary.Title.Should().Be("About Us");
        page1Summary.LastModifiedBy.Should().Be(_testAdmin.Email);

        // Verify page2 has 0 revisions
        var page2Summary = okResult.Value.First(p => p.Slug == "contact");
        page2Summary.RevisionCount.Should().Be(0);
    }

