using Microsoft.EntityFrameworkCore;
using Microsoft.Extensions.Logging;
using System.Security.Claims;
using WitchCityRope.Api.Data;
using WitchCityRope.Api.Features.Cms.Dtos;
using WitchCityRope.Api.Features.Cms.Entities;
using WitchCityRope.Api.Features.Cms.Services;
using WitchCityRope.Api.Models;
using Xunit;
using FluentAssertions;
using NSubstitute;
using Microsoft.AspNetCore.Http;

namespace WitchCityRope.UnitTests.Api.Features.Cms;

/// <summary>
/// Unit tests for CmsEndpoints following Pattern B standards.
/// Tests all CMS endpoints using in-memory database and mocked ContentSanitizer.
/// </summary>
public class CmsEndpointsTests : IDisposable
{
    private readonly ApplicationDbContext _dbContext;
    private readonly ContentSanitizer _mockSanitizer;
    private readonly ILogger<Program> _mockLogger;
    private readonly ApplicationUser _testAdmin;
    private readonly ApplicationUser _testMember;

    public CmsEndpointsTests()
    {
        // Setup in-memory database
        var options = new DbContextOptionsBuilder<ApplicationDbContext>()
            .UseInMemoryDatabase(databaseName: $"CmsTests_{Guid.NewGuid()}")
            .Options;
        _dbContext = new ApplicationDbContext(options);

        // Setup mocks
        _mockSanitizer = Substitute.For<ContentSanitizer>();
        _mockLogger = Substitute.For<ILogger<Program>>();

        // Create test users
        _testAdmin = new ApplicationUser
        {
            Id = Guid.NewGuid(),
            Email = "admin@test.com",
            SceneName = "TestAdmin",
            UserName = "admin@test.com"
        };

        _testMember = new ApplicationUser
        {
            Id = Guid.NewGuid(),
            Email = "member@test.com",
            SceneName = "TestMember",
            UserName = "member@test.com"
        };

        _dbContext.Users.AddRange(_testAdmin, _testMember);
        _dbContext.SaveChanges();
    }

    public void Dispose()
    {
        _dbContext.Database.EnsureDeleted();
        _dbContext.Dispose();
    }

    #region GetPageBySlug Tests

    /// <summary>
    /// Test: GetPageBySlug with valid published page slug returns 200 OK with ContentPageDto
    /// </summary>
    [Fact]
    public async Task GetPageBySlug_WithValidPublishedPage_Returns200OkWithContentPageDto()
    {
        // Arrange
        var page = new ContentPage
        {
            Slug = "test-page",
            Title = "Test Page",
            Content = "<p>Test content</p>",
            IsPublished = true,
            CreatedAt = DateTime.UtcNow,
            UpdatedAt = DateTime.UtcNow,
            CreatedBy = _testAdmin.Id,
            LastModifiedBy = _testAdmin.Id,
            LastModifiedByUser = _testAdmin
        };
        _dbContext.ContentPages.Add(page);
        await _dbContext.SaveChangesAsync();

        // Act
        var result = await WitchCityRope.Api.Features.Cms.CmsEndpoints.GetPageBySlug(
            "test-page",
            _dbContext,
            CancellationToken.None
        );

        // Assert
        result.Should().BeOfType<Microsoft.AspNetCore.Http.HttpResults.Ok<ContentPageDto>>();
        var okResult = result as Microsoft.AspNetCore.Http.HttpResults.Ok<ContentPageDto>;
        okResult!.Value.Should().NotBeNull();
        okResult.Value!.Slug.Should().Be("test-page");
        okResult.Value.Title.Should().Be("Test Page");
        okResult.Value.Content.Should().Be("<p>Test content</p>");
        okResult.Value.IsPublished.Should().BeTrue();
        okResult.Value.LastModifiedBy.Should().Be(_testAdmin.Email);
    }

