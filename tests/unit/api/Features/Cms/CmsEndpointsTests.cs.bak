    /// <summary>
    /// Test: GetAllPages returns pages ordered by slug
    /// </summary>
    [Fact]
    public async Task GetAllPages_ReturnsPagesOrderedBySlug()
    {
        // Arrange - create pages in non-alphabetical order
        var page1 = new ContentPage
        {
            Slug = "zebra",
            Title = "Zebra Page",
            Content = "<p>Z</p>",
            IsPublished = true,
            CreatedAt = DateTime.UtcNow,
            UpdatedAt = DateTime.UtcNow,
            CreatedBy = _testAdmin.Id,
            LastModifiedBy = _testAdmin.Id,
            LastModifiedByUser = _testAdmin
        };

        var page2 = new ContentPage
        {
            Slug = "alpha",
            Title = "Alpha Page",
            Content = "<p>A</p>",
            IsPublished = true,
            CreatedAt = DateTime.UtcNow,
            UpdatedAt = DateTime.UtcNow,
            CreatedBy = _testAdmin.Id,
            LastModifiedBy = _testAdmin.Id,
            LastModifiedByUser = _testAdmin
        };

        var page3 = new ContentPage
        {
            Slug = "middle",
            Title = "Middle Page",
            Content = "<p>M</p>",
            IsPublished = true,
            CreatedAt = DateTime.UtcNow,
            UpdatedAt = DateTime.UtcNow,
            CreatedBy = _testAdmin.Id,
            LastModifiedBy = _testAdmin.Id,
            LastModifiedByUser = _testAdmin
        };

        _dbContext.ContentPages.AddRange(page1, page2, page3);
        await _dbContext.SaveChangesAsync();

        // Act
        var result = await WitchCityRope.Api.Features.Cms.CmsEndpoints.GetAllPages(
            _dbContext,
            CancellationToken.None
        );

        // Assert
        var okResult = result as Microsoft.AspNetCore.Http.HttpResults.Ok<List<CmsPageSummaryDto>>;
        okResult!.Value.Should().HaveCount(3);
        okResult.Value![0].Slug.Should().Be("alpha");
        okResult.Value[1].Slug.Should().Be("middle");
        okResult.Value[2].Slug.Should().Be("zebra");
    }

    #endregion

    #region Helper Methods

    private ClaimsPrincipal CreateClaimsPrincipal(Guid userId)
    {
        var claims = new List<Claim>
        {
            new Claim(ClaimTypes.NameIdentifier, userId.ToString())
        };
        return new ClaimsPrincipal(new ClaimsIdentity(claims, "TestAuth"));
    }

    #endregion
}
