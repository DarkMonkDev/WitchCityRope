    /// <summary>
    /// Test: GetPageBySlug handles database errors gracefully
    /// </summary>
    [Fact]
    public async Task GetPageBySlug_WithDatabaseError_ThrowsException()
    {
        // Arrange - dispose context to simulate database error
        await _dbContext.DisposeAsync();

        // Act & Assert
        await Assert.ThrowsAsync<ObjectDisposedException>(async () =>
            await WitchCityRope.Api.Features.Cms.CmsEndpoints.GetPageBySlug(
                "any-slug",
                _dbContext,
                CancellationToken.None
            )
        );
    }

    #endregion

    #region UpdatePage Tests

    /// <summary>
    /// Test: UpdatePage with valid request returns 200 OK with updated page
    /// </summary>
    [Fact]
    public async Task UpdatePage_WithValidRequest_Returns200OkWithUpdatedPage()
    {
        // Arrange
        var page = new ContentPage
        {
            Slug = "test-page",
            Title = "Original Title",
            Content = "<p>Original content</p>",
            IsPublished = true,
            CreatedAt = DateTime.UtcNow.AddDays(-1),
            UpdatedAt = DateTime.UtcNow.AddDays(-1),
            CreatedBy = _testAdmin.Id,
            LastModifiedBy = _testAdmin.Id,
            LastModifiedByUser = _testAdmin
        };
        _dbContext.ContentPages.Add(page);
        await _dbContext.SaveChangesAsync();

        var request = new UpdateContentPageRequest
        {
            Title = "Updated Title",
            Content = "<p>Updated content with <script>alert('xss')</script></p>",
            ChangeDescription = "Updated via unit test"
        };

        var cleanContent = "<p>Updated content with </p>";
        _mockSanitizer.Sanitize(Arg.Any<string>()).Returns(cleanContent);

        var user = CreateClaimsPrincipal(_testAdmin.Id);

        // Act
        var result = await WitchCityRope.Api.Features.Cms.CmsEndpoints.UpdatePage(
            page.Id,
            request,
            user,
            _dbContext,
            _mockSanitizer,
            _mockLogger,
            CancellationToken.None
        );

        // Assert
        result.Should().BeOfType<Microsoft.AspNetCore.Http.HttpResults.Ok<ContentPageDto>>();
        var okResult = result as Microsoft.AspNetCore.Http.HttpResults.Ok<ContentPageDto>;
        okResult!.Value.Should().NotBeNull();
        okResult.Value!.Title.Should().Be("Updated Title");
        okResult.Value.Content.Should().Be(cleanContent);

        // Verify sanitizer was called
        _mockSanitizer.Received(1).Sanitize(Arg.Any<string>());

        // Verify revision was created
        var revisions = await _dbContext.ContentRevisions
            .Where(r => r.ContentPageId == page.Id)
            .ToListAsync();
        revisions.Should().HaveCount(1);
        revisions[0].Title.Should().Be("Original Title");
        revisions[0].Content.Should().Be("<p>Original content</p>");
    }

