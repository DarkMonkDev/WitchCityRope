    #region GetPageRevisions Tests

    /// <summary>
    /// Test: GetPageRevisions with valid page ID returns 200 OK with revisions list
    /// </summary>
    [Fact]
    public async Task GetPageRevisions_WithValidPageId_Returns200OkWithRevisionsList()
    {
        // Arrange
        var page = new ContentPage
        {
            Slug = "test-page",
            Title = "Current Title",
            Content = "<p>Current content</p>",
            IsPublished = true,
            CreatedAt = DateTime.UtcNow.AddDays(-10),
            UpdatedAt = DateTime.UtcNow,
            CreatedBy = _testAdmin.Id,
            LastModifiedBy = _testAdmin.Id
        };
        _dbContext.ContentPages.Add(page);
        await _dbContext.SaveChangesAsync();

        // Create multiple revisions
        var revision1 = new ContentRevision
        {
            ContentPageId = page.Id,
            Title = "Old Title 1",
            Content = "<p>Old content 1</p>",
            CreatedAt = DateTime.UtcNow.AddDays(-5),
            CreatedBy = _testAdmin.Id,
            CreatedByUser = _testAdmin,
            ChangeDescription = "First update"
        };
        var revision2 = new ContentRevision
        {
            ContentPageId = page.Id,
            Title = "Old Title 2",
            Content = "<p>Old content 2</p>",
            CreatedAt = DateTime.UtcNow.AddDays(-2),
            CreatedBy = _testAdmin.Id,
            CreatedByUser = _testAdmin,
            ChangeDescription = "Second update"
        };
        _dbContext.ContentRevisions.AddRange(revision1, revision2);
        await _dbContext.SaveChangesAsync();

        // Act
        var result = await WitchCityRope.Api.Features.Cms.CmsEndpoints.GetPageRevisions(
            page.Id,
            _dbContext,
            CancellationToken.None
        );

        // Assert
        result.Should().BeOfType<Microsoft.AspNetCore.Http.HttpResults.Ok<List<ContentRevisionDto>>>();
        var okResult = result as Microsoft.AspNetCore.Http.HttpResults.Ok<List<ContentRevisionDto>>;
        okResult!.Value.Should().NotBeNull();
        okResult.Value!.Should().HaveCount(2);

        // Verify most recent first
        okResult.Value[0].ChangeDescription.Should().Be("Second update");
        okResult.Value[1].ChangeDescription.Should().Be("First update");

        // Verify content preview (not full content)
        okResult.Value[0].FullContent.Should().BeNull();
    }

