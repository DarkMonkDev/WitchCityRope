# Multi-stage Dockerfile for Test Runner
# Orchestrates execution of unit, integration, and E2E tests in isolated environment

###########################################
# Base Node.js Image
###########################################
FROM node:20-slim AS base
WORKDIR /app

# Install dependencies needed for node-gyp, native modules, and system tools
RUN apt-get update && apt-get install -y \
    python3 \
    make \
    g++ \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Add test environment label for cleanup
LABEL witchcity.test=true
LABEL witchcity.test.timestamp=${BUILD_TIMESTAMP}

###########################################
# Dependencies Stage
###########################################
FROM base AS deps

# Copy workspace package files
COPY package*.json ./
COPY tsconfig*.json ./

# Copy workspace packages (for monorepo dependencies)
COPY packages/ ./packages/

# Install all dependencies (npm workspaces automatically installs workspace devDependencies)
RUN npm install

###########################################
# Test Runner Stage
###########################################
FROM base AS test-runner

# Copy dependencies from deps stage
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/packages ./packages

# Copy root package.json and configs
COPY package*.json ./
COPY tsconfig*.json ./
COPY playwright.config.ts ./

# Copy test files
COPY tests/ ./tests/

# Install Playwright browsers
RUN npx playwright install chromium --with-deps

# Create output directories
RUN mkdir -p \
    /app/test-results \
    /app/playwright-results \
    /app/playwright-results/html-report

# Environment configuration
ENV NODE_ENV=test
ENV CI=true
ENV PLAYWRIGHT_WORKERS=2
ENV PLAYWRIGHT_HEADED=false
ENV PLAYWRIGHT_BROWSER=chromium
ENV PLAYWRIGHT_TIMEOUT=30000

# Health check - verify Node.js and npm are available
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD node --version && npm --version

# Default to waiting - tests will be run via docker exec or command override
CMD ["tail", "-f", "/dev/null"]
