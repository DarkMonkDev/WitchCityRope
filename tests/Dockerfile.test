# Multi-stage Dockerfile for Test Runner
# Orchestrates execution of unit, integration, and E2E tests in isolated environment

# Base stage with Node.js and test dependencies
FROM node:20-slim AS base

# Add test environment label for cleanup
LABEL witchcity.test=true
LABEL witchcity.test.timestamp=${BUILD_TIMESTAMP}

WORKDIR /app

# Install system dependencies for Playwright
RUN apt-get update && apt-get install -y \
    curl \
    wget \
    ca-certificates \
    fonts-liberation \
    libasound2 \
    libatk-bridge2.0-0 \
    libatk1.0-0 \
    libatspi2.0-0 \
    libcups2 \
    libdbus-1-3 \
    libdrm2 \
    libgbm1 \
    libgtk-3-0 \
    libnspr4 \
    libnss3 \
    libwayland-client0 \
    libxcomposite1 \
    libxdamage1 \
    libxfixes3 \
    libxkbcommon0 \
    libxrandr2 \
    xdg-utils \
    && rm -rf /var/lib/apt/lists/*

# Test orchestration stage
# NOTE: This stage is not currently used by docker-compose.test.yml
# The test-runner stage (default target) is used instead
FROM base AS test-orchestrator

# Create directories for test outputs
RUN mkdir -p /app/reports /app/screenshots /app/coverage

# Install Playwright globally
RUN npm install --global \
    playwright@latest \
    && npx playwright install chromium --with-deps

# Health check - verify Node.js and npm are available
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD node --version && npm --version

# Environment configuration
ENV NODE_ENV=test
ENV CI=true
ENV PLAYWRIGHT_WORKERS=2
ENV PLAYWRIGHT_HEADED=false
ENV PLAYWRIGHT_BROWSER=chromium
ENV PLAYWRIGHT_TIMEOUT=30000

# Default to waiting - tests will be run via docker exec
CMD ["tail", "-f", "/dev/null"]

# Test runner stage - minimal for CI/CD
FROM base AS test-runner

WORKDIR /app

# Install minimal Node.js dependencies for test orchestration
RUN npm install --global \
    playwright@latest \
    && npx playwright install chromium --with-deps

# Create output directories
RUN mkdir -p /app/reports /app/screenshots /app/coverage

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD node --version && npm --version

# Environment configuration
ENV NODE_ENV=test
ENV CI=true

# Default to waiting for manual test execution
CMD ["tail", "-f", "/dev/null"]
