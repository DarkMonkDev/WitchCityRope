# WitchCityRope Production Environment Variables
# Copy this file to .env.production and fill in the values
# Location on server: /opt/witchcityrope/production/.env.production

# ==============================================================================
# Docker Image Configuration
# ==============================================================================
IMAGE_TAG=latest
APP_VERSION=1.0.0

# ==============================================================================
# Database Configuration (DigitalOcean Managed PostgreSQL via PgBouncer)
# ==============================================================================
# NOTE: Use keyword-value format, NOT URI format (required for Hangfire.PostgreSql)
# Port 25061 = PgBouncer connection pooler (recommended)
# Port 25060 = Direct database connection (not recommended - connection exhaustion risk)
PROD_DB_CONNECTION_STRING=Host=HOST;Port=25061;Database=pgbouncer-production;Username=witchcity_production;Password=PASSWORD;SSL Mode=Require;Trust Server Certificate=true

# ==============================================================================
# Authentication & Security
# ==============================================================================
JWT_SECRET=CHANGE_THIS_TO_A_SECURE_RANDOM_STRING_AT_LEAST_32_CHARACTERS

# ==============================================================================
# PayPal Configuration (LIVE - Production)
# ==============================================================================
PAYPAL_CLIENT_ID=AW0SyWbB__Qvn9O7okXlqpXndKhKvorGLAia3NIF3t7dvPAvglkitnTIvviwy90lXdlEVYrTgkXnU46o
PAYPAL_SECRET=CHANGE_THIS_TO_YOUR_LIVE_PAYPAL_SECRET
PAYPAL_MODE=live
PAYPAL_WEBHOOK_ID=CHANGE_THIS_TO_YOUR_WEBHOOK_ID_FROM_PAYPAL

# ==============================================================================
# Email Configuration (SendGrid - Production)
# ==============================================================================
Vetting__EmailEnabled=true
Vetting__SendGridApiKey=CHANGE_THIS_TO_YOUR_SENDGRID_API_KEY
Vetting__SendGridSandboxMode=false
Vetting__FromEmail=info@witchcityrope.com
Vetting__FromName=WitchCityRope

# ==============================================================================
# Frontend Configuration
# ==============================================================================
Frontend__Url=https://witchcityrope.com

# ==============================================================================
# Application Configuration
# ==============================================================================
ASPNETCORE_ENVIRONMENT=Production
NODE_ENV=production

# ==============================================================================
# Notes
# ==============================================================================
#
# To generate a secure JWT_SECRET:
#   openssl rand -base64 64
#
# Database connection string format:
#   postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
#
# Get database credentials from:
#   DigitalOcean Console → Databases → witchcityrope-prod-db → Connection Details
#   OR from server at: /opt/witchcityrope/database-credentials.env
#
# PayPal Configuration:
#   Get credentials from: https://developer.paypal.com/
#   IMPORTANT: Must use LIVE mode, not sandbox
#   Webhook ID: Register webhook at PayPal Developer Dashboard
#
# SendGrid Configuration:
#   Get API key from: https://app.sendgrid.com/settings/api_keys
#   SandboxMode MUST be false for production
#
# Frontend URL:
#   Used for email verification links and redirects
#   Should match your primary domain
#
# This file should be created on the server at:
#   /opt/witchcityrope/production/.env.production
#
# File permissions should be restricted:
#   chmod 600 /opt/witchcityrope/production/.env.production
#   chown witchcity:witchcity /opt/witchcityrope/production/.env.production
