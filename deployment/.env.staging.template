# WitchCityRope Staging Environment Variables
# Copy this file to .env.staging and fill in the values
# Location on server: /opt/witchcityrope/staging/.env.staging

# ==============================================================================
# Docker Image Configuration
# ==============================================================================
IMAGE_TAG=staging
APP_VERSION=staging

# ==============================================================================
# Database Configuration (DigitalOcean Managed PostgreSQL via PgBouncer)
# ==============================================================================
# NOTE: Use keyword-value format, NOT URI format (required for Hangfire.PostgreSql)
# Port 25061 = PgBouncer connection pooler (recommended)
# Port 25060 = Direct database connection (not recommended - connection exhaustion risk)
STAGING_DB_CONNECTION_STRING=Host=HOST;Port=25061;Database=pgbouncer-staging;Username=doadmin;Password=PASSWORD;SSL Mode=Require;Trust Server Certificate=true

# ==============================================================================
# Authentication & Security
# ==============================================================================
JWT_SECRET=CHANGE_THIS_TO_A_SECURE_RANDOM_STRING_AT_LEAST_32_CHARACTERS

# ==============================================================================
# Email Configuration (SendGrid)
# ==============================================================================
# Required for email verification, password reset, and system notifications
# Get API key from: https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=SG.CHANGE_THIS_TO_YOUR_SENDGRID_API_KEY

# ==============================================================================
# Application Configuration
# ==============================================================================
ASPNETCORE_ENVIRONMENT=Staging
NODE_ENV=production

# ==============================================================================
# Notes
# ==============================================================================
#
# To generate a secure JWT_SECRET:
#   openssl rand -base64 64
#
# Database connection string format:
#   postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
#
# Get database credentials from:
#   DigitalOcean Console → Databases → witchcityrope-prod-db → Connection Details
#   OR from server at: /opt/witchcityrope/database-credentials.env
#
# To get SendGrid API key:
#   1. Log in to https://app.sendgrid.com
#   2. Navigate to Settings → API Keys
#   3. Create new API key with "Mail Send" permissions
#   4. Copy the key (starts with SG.) - shown only once!
#   5. Add to this file as SENDGRID_API_KEY
#
# This file should be created on the server at:
#   /opt/witchcityrope/staging/.env.staging
#
# File permissions should be restricted:
#   chmod 600 /opt/witchcityrope/staging/.env.staging
#   chown witchcity:witchcity /opt/witchcityrope/staging/.env.staging
